<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 HakuChya (HakumomoHacha)</Copyright>
    <RepositoryUrl>https://github.com/HakumomoHacha/HeartVRChat</RepositoryUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PulsoidVRC</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../PulsoidVRC.Core/PulsoidVRC.Core.csproj" /></ItemGroup>
</Project>
